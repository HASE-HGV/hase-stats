NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Nur für die serverseitigen Admin-Routen (app/api/admin/*).
# Niemals mit dem NEXT_PUBLIC_-Präfix versehen, sonst landet der Key im Browser-Bundle.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional: Basis-URL der App. Wird nur als Fallback für den gedruckten
# QR-Code (/stats/qr) gebraucht — normalerweise liest die App die URL aus den
# Request-Headern. Nötig, wenn lokal entwickelt wird, damit der QR-Code nicht
# auf "localhost" zeigt.
# NEXT_PUBLIC_SITE_URL=https://dein-deployment.vercel.app
